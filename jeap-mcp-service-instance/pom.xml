<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-mcp-service</artifactId>
        <version>2.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>jeap-mcp-service-instance</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <packaging>pom</packaging>

    <description>Parent POM for platform-specific instances of jeap-mcp-service to inherit from.
        Declares the dependency on jeap-mcp-service-web so instance repos get it for free; each
        instance repo still configures its own spring-boot-maven-plugin mainClass and adds
        whichever platform-specific dependencies it needs - none of that belongs here, following
        the same pattern as jeap-archrepo-service/jeap-archrepo-instance.</description>

    <properties>
        <!-- prevent the license plugin from adding a THIRD-PARTY-LICENSES.md file to this pom packaged project -->
        <license.skipAggregateAddThirdParty>true</license.skipAggregateAddThirdParty>
    </properties>

    <dependencies>
        <!-- Explicit ${project.parent.version}, not the inherited dependencyManagement entry in
             the root pom (which uses ${project.version}): that placeholder resolves against
             whichever project actually consumes this POM, not against this reactor's own
             version - so a downstream instance repo (with its own unrelated version) would
             silently get its OWN version substituted in, not jeap-mcp-service-web's.
             ${project.parent.version} always means "this project's own parent's version"
             regardless of who's inheriting it, which is what's needed since -web/-instance/the
             root are always published together under the same version. -->
        <dependency>
            <groupId>ch.admin.bit.jeap</groupId>
            <artifactId>jeap-mcp-service-web</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <!-- While jEAP must produce a javadoc artifact for all modules due to Maven Central requirements,
            service instances will often not contain any code and javadoc generation would fail. Such failures
            are ignored here, and service instances can still decide to skip javadoc generation altogether using
            java.skip=true. -->
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <failOnError>false</failOnError>
                        <doclint>none</doclint>
                        <quiet>true</quiet>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Disable all license plugin executions from the parent to avoid instances of the service
             inheriting these plugin executions. -->
            <plugin>
                <groupId>org.honton.chas</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>add-third-party</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
